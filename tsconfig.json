{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "CommonJS",
    "target": "ES2020",
    
    /* Output */
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,

    /* Linting */
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}